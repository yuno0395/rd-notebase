{
  "data_version": 2,
  "templates_folder": "_templates",
  "user_scripts_folder": "_templates/_scripts",
  "trigger_on_file_creation_mode": "regex",
  "file_templates": [
    {
      "regex": "(^|/)01_目的/",
      "template": "_templates/目的.md"
    },
    {
      "regex": "(^|/)02_ノード/",
      "template": "_templates/ノード.md"
    },
    {
      "regex": "(^|/)03_イシュー/",
      "template": "_templates/イシュー.md"
    },
    {
      "regex": "(^|/)04_タスク/",
      "template": "_templates/タスク.md"
    },
    {
      "regex": "(^|/)05_結果/",
      "template": "_templates/ナレッジ.md"
    }
  ],
  "folder_templates": [],
  "ignore_folders_on_creation": [
    {
      "folder": "_templates"
    },
    {
      "folder": "_attachments"
    },
    {
      "folder": "99_archive"
    },
    {
      "folder": "90_共有"
    }
  ],
  "auto_jump_to_cursor": true,
  "syntax_highlighting": true,
  "command_timeout": 5
}