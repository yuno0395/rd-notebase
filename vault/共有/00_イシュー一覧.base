filters:
  and:
    - '!file.inFolder("_仕組み/templates")'
    - type == "イシュー"
formulas:
  # 仕様書「priority の決め方」の表。同期プログラムがまだ priority を書いていなくても並ぶ。
  # 同期プログラムが lead_weeks で priority 1 に上げたものは 1 のまま。
  prio: 'if(priority == 1, 1, if(impact == "方針" || impact == "絞込", if(speed == "時間がかかる", 2, 1), if(impact == "出荷", if(speed == "時間がかかる", 3, 2), if(impact == "中", if(speed == "時間がかかる", 4, 3), if(impact == "小", 4, 2)))))'
properties:
  formula.prio:
    displayName: priority
views:
  - type: table
    name: priority 順
    filters:
      and:
        - status != "解消"
        - status != "中止"
    order:
      - file.name
      - formula.prio
      - impact
      - speed
      - status
      - resolution
      - project
    sort:
      - property: formula.prio
        direction: ASC
  - type: table
    name: impact 未判定(金曜の定例で直す)
    filters:
      and:
        - impact == "未判定"
    order:
      - file.name
      - speed
      - status
      - project
  - type: table
    name: すべて
    order:
      - file.name
      - formula.prio
      - impact
      - status
      - resolution
      - project
