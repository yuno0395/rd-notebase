filters:
  and:
    - '!file.inFolder("_仕組み/templates")'
    - type == "設計記録"
views:
  - type: table
    name: 候補の一組(イシューごと)
    filters:
      and:
        - status != "不採用"
    groupBy:
      property: parent
      direction: ASC
    order:
      - file.name
      - status
      - drawing_no
      - previous
      - author
    sort:
      - property: status
        direction: ASC
  - type: table
    name: すべて(不採用も)
    groupBy:
      property: parent
      direction: ASC
    order:
      - file.name
      - status
      - drawing_no
      - parent
      - author
