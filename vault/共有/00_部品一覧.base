filters:
  and:
    - '!file.inFolder("_仕組み/templates")'
    - type == "ノード"
    - kind == "部品"
formulas:
  # 名前の列: ファイル名(id_名前)の代わりに aliases の最初の名前を出す。押せばノートが開く。
  # aliases が空なら、ファイル名から id を外した名前
  alias: 'file.asLink(if(list(aliases).filter(value).length > 0, list(aliases).filter(value)[0], file.basename.replace(/^[0-9A-Z]{6}[0-9A-Z]+_/, "")))'
  # 金額 = 単価 × 個数(どちらかが空なら空)
  amount: 'if(note["単価"] && note["個数"], number(note["単価"]) * number(note["個数"]), "")'
  # 書いていなければ未着手(未発注)
  st: 'if(status, status, "未着手")'
properties:
  formula.alias:
    displayName: 別名
  parent:
    displayName: 入る Assy
  formula.amount:
    displayName: 金額
  formula.st:
    displayName: status
  drawing_no:
    displayName: 図番
views:
  - type: cards
    name: カード(概略図)
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.5625
    order:
      - formula.alias
      - id
      - drawing_no
      - project
      - formula.st
      - 個数
      - 発注先
    sort:
      - property: drawing_no
        direction: ASC
  - type: cards
    name: 図番ごと(概略図)
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.5625
    groupBy:
      property: drawing_no
      direction: ASC
    order:
      - formula.alias
      - id
      - drawing_no
      - parent
      - formula.st
  - type: table
    name: プロジェクトごと
    groupBy:
      property: project
      direction: ASC
    order:
      - formula.alias
      - id
      - parent
      - drawing_no
      - 個数
      - formula.amount
      - formula.st
  - type: table
    name: Assy ごと(部品の構成)
    groupBy:
      property: parent
      direction: ASC
    order:
      - formula.alias
      - id
      - 個数
      - 単価
      - formula.amount
      - 発注先
      - formula.st
      - PurchaseNo
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: まだ発注していない(未着手・進行中)
    filters:
      or:
        - '!status'
        - status == "未着手"
        - status == "進行中"
    order:
      - formula.alias
      - id
      - parent
      - 個数
      - 単価
      - formula.amount
      - 発注先
      - formula.st
  - type: table
    name: 納品待ち(待ち)
    filters:
      and:
        - status == "待ち"
    groupBy:
      property: 発注先
      direction: ASC
    order:
      - formula.alias
      - id
      - parent
      - 個数
      - PurchaseNo
      - formula.amount
  - type: table
    name: 発注状況ごと
    groupBy:
      property: formula.st
      direction: ASC
    order:
      - formula.alias
      - id
      - parent
      - 個数
      - 単価
      - formula.amount
      - 発注先
      - PurchaseNo
  - type: table
    name: 発注先ごと
    filters:
      and:
        - status != "中止"
    groupBy:
      property: 発注先
      direction: ASC
    order:
      - formula.alias
      - id
      - parent
      - 個数
      - 単価
      - formula.amount
      - formula.st
      - PurchaseNo
