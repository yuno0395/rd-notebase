filters:
  and:
    - '!file.inFolder("_仕組み/templates")'
    - type == "タスク"
views:
  - type: table
    name: 進行中・待ち・確認待ち
    filters:
      or:
        - status == "進行中"
        - status == "待ち"
        - status == "確認待ち"
    order:
      - file.name
      - status
      - due
      - owner
      - author
      - parent
    sort:
      - property: due
        direction: ASC
  - type: table
    name: 未着手(期限順)
    filters:
      and:
        - status == "未着手"
    order:
      - file.name
      - due
      - owner
      - parent
    sort:
      - property: due
        direction: ASC
