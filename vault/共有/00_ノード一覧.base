filters:
  and:
    - '!file.inFolder("_仕組み/templates")'
    - type == "ノード"
formulas:
  # 名前の列: ファイル名(id_名前)の代わりに aliases の最初の名前を出す。押せばノートが開く。
  # aliases が空なら、ファイル名から id を外した名前
  alias: 'file.asLink(if(list(aliases).filter(value).length > 0, list(aliases).filter(value)[0], file.basename.replace(/^[0-9A-Z]{6}[0-9A-Z]+_/, "")))'
  # 書いていなければ仮説(仕様書「属性」)
  mat: 'if(maturity, maturity, "仮説")'
properties:
  formula.alias:
    displayName: 別名
  formula.mat:
    displayName: maturity
views:
  - type: table
    name: value_kind 未分類(金曜の定例で分ける)
    filters:
      and:
        - '!value_kind'
    order:
      - formula.alias
      - id
      - parts
      - author
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: maturity ごと
    groupBy:
      property: formula.mat
      direction: ASC
    order:
      - formula.alias
      - id
      - formula.mat
      - value_kind
      - parts
      - author
  - type: table
    name: すべて
    order:
      - formula.alias
      - id
      - value_kind
      - formula.mat
      - parts
  - type: cards
    name: カード(図)
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.5625
    order:
      - formula.alias
      - id
      - value_kind
      - formula.mat
      - parts
    sort:
      - property: file.ctime
        direction: DESC
