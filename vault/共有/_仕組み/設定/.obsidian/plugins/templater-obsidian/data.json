    },
    {
      "template": "_仕組み/templates/_コマンド/ナレッジにする.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/関係としてつなぐ.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/反論としてつなぐ.md",
      "insert_enabled": true,
      "create_enabled": false
    }
  ]
}
