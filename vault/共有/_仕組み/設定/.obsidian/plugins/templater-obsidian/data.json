{
  "data_version": 2,
  "templates_folder": "_仕組み/templates",
  "user_scripts_folder": "_仕組み/templates/_scripts",
  "trigger_on_file_creation_mode": "regex",
  "file_templates": [
    {
      "regex": "(^|/)01_目的/",
      "template": "_仕組み/templates/目的.md"
    },
    {
      "regex": "(^|/)02_ノード/",
      "template": "_仕組み/templates/ノード.md"
    },
    {
      "regex": "(^|/)03_イシュー/",
      "template": "_仕組み/templates/イシュー.md"
    },
    {
      "regex": "(^|/)04_タスク/",
      "template": "_仕組み/templates/タスク.md"
    },
    {
      "regex": "(^|/)05_ナレッジ/",
      "template": "_仕組み/templates/ナレッジ.md"
    }
  ],
  "folder_templates": [],
  "ignore_folders_on_creation": [
    {
      "folder": "_仕組み/templates"
    },
    {
      "folder": "_仕組み/attachments"
    },
    {
      "folder": "99_archive"
    }
  ],
  "auto_jump_to_cursor": true,
  "syntax_highlighting": true,
  "command_timeout": 5,
  "enabled_templates_hotkeys": [
    {
      "template": "_仕組み/templates/_コマンド/図を開く.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/ノードにする.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/保存.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/イシューにする.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/タスクにする.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/仮説にする.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/設計案にする.md",
      "insert_enabled": true,
      "create_enabled": false
    },
    {
      "template": "_仕組み/templates/_コマンド/目的にする.md",
