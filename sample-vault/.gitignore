# 他人のノートのスタブ・キャッシュ・完全ローカルのメモはGitに入れない
_refs/
_cache/
_private/
# notebase が保存できない時に置くお知らせ（直ると消える）
/_notebase*
# Obsidianの画面状態（人ごとに違う）
.obsidian/workspace*.json
.obsidian/cache
.trash/
.venv/
venv/
__pycache__/
# プラグイン本体と配布の記録は notebase が配る（Gitに入れない）
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/manifest.json
.rdnb/managed.json
